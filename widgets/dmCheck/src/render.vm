<div class="dc-root" data-project="$esc.html($dmProjectId)" data-version="$bwVersion" data-height="$graphHeight" data-item="$esc.html($dmItemId)" data-item-project="$esc.html($dmItemProject)" data-rev="$esc.html($dmItemRev)" data-uses="$esc.html($dmUses)" data-name="$esc.html($dmName)" data-run="$dcRunF" data-note="$esc.html($dcNote)" data-items="$dcItemN" data-links="$dcLinkN" data-unres="$dcUnres" data-capped="$dcCapF" data-cap="$dcListCap" data-unexp="$dmUnexpLinks" data-view="$initialView">
<div class="dc-head"><b>Data Model Check</b>#if($dmName != "") &mdash; $esc.html($dmName)#end &mdash; model $esc.html($itemLabel) <span class="bw-muted">(widget v$bwVersion)</span></div>
<div class="bw-model" style="display:none">

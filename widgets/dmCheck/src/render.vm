  #set($dcsO = "$dcsV")
  #set($dcsO = $dcsO.replace("|", " ").replace(";", " "))
#end

#if(!$dmOpt && $dmItemIdP == "")
<div class="dc-root"><div class="bw-muted"><b>Data Model Check</b>: select the model document (and, if needed, the model work item) in the widget parameters. <span class="bw-muted">(widget v$bwVersion)</span></div></div>
#elseif($isStatic)
## ======================================================================= static view (PDF / print)
<div class="dc-root dc-static">
<div class="dc-head"><b>Data Model Check</b>#if($dmName != "") &mdash; $esc.html($dmName)#end &mdash; model $esc.html($itemLabel) <span class="bw-muted">(widget v$bwVersion)</span></div>
#if(!$dcRun)
<div class="bw-error">$esc.html($dcNote)</div>
#end
#if($dmProbs.size() > 0)
<div class="dc-h">Model problems</div>
<table class="bw-table">
<tr><th>Severity</th><th>Line</th><th>Problem</th></tr>
#foreach($p in $dmProbs)
<tr><td>$p.get(0)</td><td>#if($p.get(1) > 0)$p.get(1)#end</td><td>$esc.html($p.get(2))</td></tr>
#end
</table>
#end
#if($dcRun)
<div>$dcItemN work items, $dcLinkN links checked &mdash; $nErr errors, $nWarn warnings, $nInfo info#if($dcCapped) &mdash; <span class="bw-error">limit reached: results are incomplete</span>#end</div>
<div class="dc-h">Rules</div>
<table class="bw-table">
<tr><th>Rule</th><th>From</th><th>Link role</th><th>To</th><th>Source items with enough links</th><th>Target items with enough links</th><th>Cross-pair links</th><th>Unpaired documents</th><th>Severity</th></tr>
#foreach($u in $dmRules)
  #set($st = $dcStat.get($u.get("id")))
<tr><td>$esc.html($u.get("id"))</td><td>$esc.html($u.get("from"))</td><td>$esc.html($u.get("rname"))</td><td>$esc.html($u.get("to"))</td><td>#if($u.get("fmin") > 0)$st.get("fo") / $st.get("fc")#else &mdash;#end</td><td>#if($u.get("tmin") > 0)$st.get("to") / $st.get("tc")#else &mdash;#end</td><td>$st.get("cross")</td><td>$st.get("unp")</td><td>$u.get("sev")#if($u.get("fromsev") != $u.get("sev") || $u.get("tosev") != $u.get("sev")) (sources: $u.get("fromsev"), targets: $u.get("tosev"))#end</td></tr>
#end
</table>
<div class="dc-h">Documents</div>
<table class="bw-table">
<tr><th>Document</th><th>Roles</th><th>Counted items</th><th>Items with a violation</th></tr>
#foreach($d in $dcDocs)
<tr><td>$esc.html($d.get("key"))</td><td>$esc.html($d.get("roles"))</td><td>$d.get("items")</td><td>$d.get("bad")</td></tr>
#end
</table>
<div class="dc-h">Violations ($dcViol.size() listed)</div>
<table class="bw-table">
<tr><th>Severity</th><th>Check</th><th>Rule</th><th>Document</th><th>Message</th></tr>
#foreach($v in $dcViol)
<tr><td>$v.get(0)</td><td>$v.get(1)</td><td>$esc.html($v.get(2))</td><td>$esc.html($v.get(3))</td><td>$esc.html($v.get(5))</td></tr>
#end
</table>
#end
</div>
#else
## ======================================================================= interactive view: page model + script
#set($dcRunF = "0")
#if($dcRun)
  #set($dcRunF = "1")
#end
#set($dcCapF = "0")
#if($dcCapped)

  .dd-in { font-size: 12px; padding: 2px 4px; border: 1px solid rgb(170,178,195); border-radius: 3px; }
  .dd-seg { display: inline-flex; }
  .dd-seg-b { font-size: 11px; padding: 1px 6px; cursor: pointer; border: 1px solid rgb(170,178,195); background: rgb(248,249,252); margin-right: -1px; }
  .dd-pick { font-size: 12px; padding: 2px 6px; cursor: pointer; border: 1px solid rgb(120,132,155); background: rgb(255,255,255); border-radius: 3px; min-width: 90px; text-align: left; }
  .dd-pick.dd-empty { color: rgb(140,146,160); font-style: italic; }
  .dd-rm { font-size: 11px; padding: 0 6px; }
  .dd-items td { padding: 2px 4px; }
  .dd-chip { display: inline-block; border: 1px solid rgb(170,178,195); border-radius: 10px; padding: 0 2px 0 8px; background: rgb(240,244,250); }
  .dd-chip-x { border: none; background: none; cursor: pointer; color: rgb(198,40,40); }
  .dd-pairs { margin-left: 24px; }
  .dd-pp { position: absolute; z-index: 40; background: rgb(255,255,255); border: 1px solid rgb(170,178,195); box-shadow: 0 2px 6px rgba(0,0,0,0.2); padding: 4px; width: 340px; }
  .dd-pp-search { width: 320px; margin-bottom: 4px; }
  .dd-pp-list { max-height: 260px; overflow: auto; }
  .dd-pp-row { padding: 2px 4px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dd-pp-row:hover { background: rgb(232,237,247); }
  .dd-pp-free { font-style: italic; color: rgb(51,103,214); }
  .dd-ed-checks { margin: 6px 0; max-height: 140px; overflow: auto; }

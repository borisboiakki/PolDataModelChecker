## Data Model Definition - render.vm
## Source: widgets/dmDefine/src/render.vm. tools/build-widget.py inlines the shared snippets (shared/vm) at the
## BW_SHARED markers and shared/js/core.js + graph.js at the BW_INLINE_JS marker, checks the result with
## Velocity 1.4 and writes widgets/dmDefine/dist/dmDefine.zip.
## Velocity 1.4 dialect (guide 3.1.9): no map literals, one statement per line, no backslashes in strings.
## Model pipeline (docs/ARCHITECTURE.md 3): dm-read.vm (model item -> text lines), dm-yaml.vm (YAML subset -> paths),
## dm-model.vm (roles, rules, bindings, validation). Graph edge "to>from": o = target role (left), c = source role.
#set($bwVersion = "0.2.0")
## BW_SHARED style.vm
<style>
  .dd-head { margin-bottom: 4px; }
  .dd-probs { border: 1px solid rgb(230,200,200); background: rgb(253,247,247); padding: 4px 8px; margin-bottom: 6px; max-height: 160px; overflow: auto; }
  .dd-probs.dd-ok { border-color: rgb(200,225,205); background: rgb(246,252,247); color: rgb(26,110,55); }
  .dd-prob { margin: 1px 0; }
  .dd-sev { display: inline-block; min-width: 54px; font-weight: 600; }
  .dd-sev-error { color: rgb(198,40,40); }
  .dd-sev-warning { color: rgb(170,105,0); }
  .dd-sev-info { color: rgb(51,103,214); }
  .dd-line { color: rgb(51,103,214); cursor: pointer; text-decoration: underline; margin-right: 6px; }
  .dd-text { border: 1px solid rgb(215,220,230); background: rgb(250,251,253); max-height: 360px; overflow: auto; margin-bottom: 6px; font-family: Consolas, monospace; font-size: 12px; }
  .dd-tl { white-space: pre; padding: 0 6px; }
  .dd-tl span.dd-no { display: inline-block; width: 36px; color: rgb(140,146,160); text-align: right; margin-right: 8px; user-select: none; }
  .dd-tl.dd-bad { background: rgb(253,232,232); }
  .dd-tl.dd-flash { outline: 2px solid rgb(230,126,34); }
  .dd-h { font-weight: 600; margin: 10px 0 2px 0; }
  .dd-static td, .dd-static th { font-size: 11px; }
</style>


#if(!$isPdf)
<h4>S4 REST API from the widget (browser only; nothing runs until a button is clicked)</h4>
<div class="dms-rest" data-project="$esc.html($miProject)" data-id="$esc.html($miId)">
<button type="button" data-a="token">1. Token function</button>
<button type="button" data-a="get">2. GET the model item (token)</button>
<button type="button" data-a="getnt">3. GET without token (session cookie only)</button>
<button type="button" data-a="patch">4. PATCH the description back unchanged (after 2)</button>
<pre class="dms-out">Model item: $esc.html($miProject)/$esc.html($miId)</pre>
</div>
<script>
(function () {
  var roots = document.querySelectorAll('.dms-rest');
  var root = roots[roots.length - 1];
  var out = root.querySelector('.dms-out');
  var project = root.getAttribute('data-project');
  var id = root.getAttribute('data-id');
  var lastDesc = null;
  function log(t) { out.textContent = out.textContent + String.fromCharCode(10) + t; }
  function token() {
    try { return (top.getRestApiToken && top.getRestApiToken()) || null; } catch (e) { return 'error: ' + e; }
  }
  // Run 1 on 2512: PATCH refused the fields[workitems] query parameter (HTTP 400): only GET carries it.
  function url(method) {
    var u = '/polarion/rest/v1/projects/' + encodeURIComponent(project) + '/workitems/' + encodeURIComponent(id);
    return method === 'GET' ? u + '?fields[workitems]=title,description' : u;
  }
  function call(method, withToken, body) {
    var h = { 'Accept': 'application/json' };
    if (withToken) { h['X-Polarion-REST-Token'] = token(); }
    if (body) { h['Content-Type'] = 'application/json'; }
    var t0 = Date.now();
    return fetch(url(method), { method: method, headers: h, credentials: 'same-origin', body: body ? JSON.stringify(body) : undefined })
      .then(function (r) {
        return r.text().then(function (txt) {
          log(method + (withToken ? ' (token)' : ' (no token)') + ': HTTP ' + r.status + ' in ' + (Date.now() - t0) + ' ms');
          log(txt ? txt.substring(0, 1500) : '(empty body)');
          return { status: r.status, text: txt };
        });
      })
      .catch(function (e) { log(method + ' failed: ' + e); return null; });
  }
  root.addEventListener('click', function (ev) {
    var a = ev.target.getAttribute && ev.target.getAttribute('data-a');
    if (!a) { return; }
    if (!id) { log('No model item located (S2): nothing to call.'); return; }
    if (a === 'token') {
      var t = token();
      log('typeof top.getRestApiToken: ' + (function () { try { return typeof top.getRestApiToken; } catch (e) { return 'error: ' + e; } })());
      log('token: ' + (t ? 'present, ' + String(t).length + ' characters' : 'none'));
    } else if (a === 'get' || a === 'getnt') {
      call('GET', a === 'get').then(function (res) {
        if (res && res.status === 200 && a === 'get') {
          try {
            var j = JSON.parse(res.text);
            lastDesc = j.data.attributes.description || null;
            log('description object: ' + JSON.stringify(lastDesc).substring(0, 300));
          } catch (e) { log('JSON not read: ' + e); }
        }
      });
    } else if (a === 'patch') {
      if (!lastDesc) { log('Run 2 first (the description read by GET is written back unchanged).'); return; }
      if (!window.confirm('PATCH the description of ' + project + '/' + id + ' with its current value (no content change, a new revision may be created)?')) { return; }
      call('PATCH', true, { data: { type: 'workitems', id: project + '/' + id, attributes: { description: lastDesc } } });
    }
  });
})();
</script>
